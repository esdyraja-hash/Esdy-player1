<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FC">
  <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp" android:paddingTop="34dp">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#1B1F3B" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/bAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗂" android:textSize="24sp" android:padding="12dp"/>
    <TextView android:id="@+id/bSearch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔍" android:textSize="24sp" android:padding="12dp"/>
  </LinearLayout>
  <HorizontalScrollView android:id="@+id/chipsH" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/header" android:scrollbars="none">
    <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp"/>
  </HorizontalScrollView>
  <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/chipsH" android:layout_above="@id/nav" android:divider="@null" android:clipToPadding="false" android:paddingBottom="84dp"/>
  <TextView android:id="@+id/fab" android:layout_width="64dp" android:layout_height="64dp" android:layout_above="@id/nav" android:layout_alignParentEnd="true" android:layout_marginEnd="20dp" android:layout_marginBottom="84dp" android:background="@drawable/fab" android:gravity="center" android:text="▶" android:textColor="#fff" android:textSize="28sp"/>
  <LinearLayout android:id="@+id/mini" android:layout_width="match_parent" android:layout_height="56dp" android:layout_above="@id/nav" android:layout_margin="10dp" android:background="@drawable/mini" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="8dp" android:visibility="gone">
    <TextView android:id="@+id/miniTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#fff" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/miniPlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fff" android:textSize="22sp" android:padding="12dp" android:text="❚❚"/>
    <TextView android:id="@+id/miniNext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fff" android:textSize="22sp" android:padding="12dp" android:text="⏭"/>
    <TextView android:id="@+id/miniQ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fff" android:textSize="22sp" android:padding="12dp" android:text="☰"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="64dp" android:layout_alignParentBottom="true" android:background="#FFFFFF">
    <TextView android:id="@+id/navL" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="📁\nLocal" android:textSize="13sp"/>
    <TextView android:id="@+id/navM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="🎵\nMusic" android:textSize="13sp"/>
  </LinearLayout>
</RelativeLayout>
