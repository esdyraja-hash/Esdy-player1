<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000">
  <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlc" android:layout_width="match_parent" android:layout_height="match_parent"/>
  <View android:id="@+id/night" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66482300" android:visibility="gone"/>
  <TextView android:id="@+id/hud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="#99000000" android:textColor="#fff" android:textSize="22sp" android:padding="12dp" android:visibility="gone"/>
  <LinearLayout android:id="@+id/top" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical" android:background="#99000000" android:padding="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <ImageButton android:id="@+id/bBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" />
      <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#fff" android:textSize="14sp" android:maxLines="2" android:paddingStart="6dp"/>
      <ImageButton android:id="@+id/bAud" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_music" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" /><ImageButton android:id="@+id/bSub" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_cc" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" />
      <Button android:id="@+id/bDec" style="@style/Ib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HW" android:textSize="16sp"/>
      <ImageButton android:id="@+id/bMore" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_more" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/qa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
  </LinearLayout>
  <LinearLayout android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="#99000000" android:padding="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <TextView android:id="@+id/tCur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fff" android:text="00:00" android:padding="6dp"/>
      <SeekBar android:id="@+id/seek" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="1000"/>
      <TextView android:id="@+id/tDur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#fff" android:text="00:00" android:padding="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <ImageButton android:id="@+id/bLock" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_unlock" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" /><View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><ImageButton android:id="@+id/bPrev" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_prev" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" /><ImageButton android:id="@+id/bPlay" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_pause" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="10dp" /><ImageButton android:id="@+id/bNext" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_next" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" /><View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><ImageButton android:id="@+id/bAr" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_aspect" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" /><ImageButton android:id="@+id/bPip" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_pip" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" />
    </LinearLayout>
  </LinearLayout>
  <ImageButton android:id="@+id/bUnlock" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_lock" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:padding="12dp" android:layout_gravity="end|center_vertical" android:visibility="gone"/>
  <LinearLayout android:id="@+id/subBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginBottom="124dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="40dp" android:paddingEnd="40dp" android:visibility="gone">
    <TextView android:id="@+id/subL1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="19sp" android:gravity="center" android:shadowColor="#000000" android:shadowRadius="6" android:shadowDx="1" android:shadowDy="1" android:background="#66000000" android:padding="6dp"/>
    <TextView android:id="@+id/subL2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE9C8" android:textSize="15sp" android:textStyle="italic" android:gravity="center" android:shadowColor="#000000" android:shadowRadius="6" android:background="#66000000" android:padding="5dp" android:visibility="gone"/>
  </LinearLayout>
  <ScrollView android:id="@+id/panelHost" android:layout_width="360dp" android:layout_height="match_parent" android:layout_gravity="end" android:background="#F0101010" android:visibility="gone">
    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"/>
  </ScrollView>
</FrameLayout>
